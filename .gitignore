# ---- Large / regenerable artifacts (keep out of git) ----
# Per-residue ESM-2 embedding cache is ~500 MB (> GitHub's 100 MB limit); regenerate from sequences.
esm_residue_fp16.npy
esm_residue_len.npy
esm_embeddings.npy
# Per-residue ProstT5 embedding cache is ~900 MB (> GitHub's 100 MB limit); regenerate via embed_prostt5.py.
prostt5_residue_fp16.npy
prostt5_residue_len.npy
# Pairwise-identity matrix cache (regenerate via fpbase_cluster.ipynb)
identity_matrix.npy
identity_matrix.meta.json
# Sequence-keyed ESM-2 max-pool cache for design ID/PCA (regenerate by rerunning the campaign notebook)
.embed_cache/
# Whole-FPbase max-pooled ESM-2 map cache (regenerate via dataset_pipeline/embed_fpbase_maxpool.py)
fpbase_esm2_650M_max.npy
fpbase_esm2_650M_max.meta.json
# Atkinson Hyperlegible faces for the Arcadia figure style, cut from the Google Fonts
# variable originals (regenerate via dataset_pipeline/fetch_arcadia_fonts.py)
dataset_pipeline/fonts/
# Trained model binaries (regenerate by re-running the notebooks)
*.pt
*.joblib
# Exceptions: keep the fpdesign/models models tracked in git
!fpdesign/models/brightness_cnn-max-d2_40k.pt
!fpdesign/models/surrogate_cnn-max-d1_alldata.pt

# ESM-2 weights are downloaded to the torch hub cache (~/.cache/torch), not here — nothing to ignore,
# but block them if ever copied locally:
*.pt.lock
checkpoints/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ipython/

# ---- Jupyter ----
.ipynb_checkpoints/
nbconvert*.log

# ---- Environments ----
.venv/
venv/
env/
.conda/

# ---- OS / editor ----
.DS_Store
*.swp
.idea/
.vscode/

# Cached trained models (regenerable). The `dir/*` form rather than a bare `dir/` matters: git
# does not descend into an ignored directory, so a bare rule here would make the per-folder
# negations (e.g. GFP_DMS/.gitignore re-including the sweep leaderboard) unreachable.
**/trained_models/*

# ---- Archived / superseded material (kept locally, out of git) ----
# Any archive/ folder anywhere in the tree — old notebooks, superseded designs, EDA, etc.
archive/

# Optional non-published MSA input variant (regenerate via msa_conservation/build_msa_input.py --peak-only)
msa_conservation/data/fp_peak_only.*
