__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ipython/

# ---- Jupyter ----
.ipynb_checkpoints/
nbconvert*.log

# ---- Environments ----
.venv/
venv/
env/
.conda/

